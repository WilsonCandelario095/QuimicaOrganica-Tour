	<style name="newhs_poly"
		fillcolor="0x3fa7ff"
		fillalpha="0.22"
		bordercolor="0xffffff"
		borderalpha="1.0"
		borderwidth="2"
		alpha="0.9"
	/>

	<action name="show_primera_1">
		set(hotspot[spot1].visible, true);
		set(hotspot[newhs_1].visible, true);
		set(hotspot[spot2].visible, false);
	</action>

	<action name="show_primera_bienvenido">
		set(hotspot[spot2].visible, true);
		set(hotspot[newhs_1].visible, false);
		set(hotspot[spot1].visible, false);
	</action>

	<action name="show_cuarta_1">
		set(hotspot[newhs_1].visible, false);
		set(hotspot[spot2].visible, true);
	</action>

	<action name="show_cuarta_1_back">
		set(hotspot[newhs_1].visible, true);
		set(hotspot[spot2].visible, false);
	</action>

	<action name="show_cuarta_2">
		set(hotspot[newhs_2].visible, false);
		set(hotspot[spot3].visible, true);
	</action>

	<action name="show_cuarta_2_back">
		set(hotspot[newhs_2].visible, true);
		set(hotspot[spot3].visible, false);
	</action>

	<action name="show_cuarta_3">
		set(hotspot[newhs_3].visible, false);
		set(hotspot[spot4].visible, true);
	</action>

	<action name="show_cuarta_3_back">
